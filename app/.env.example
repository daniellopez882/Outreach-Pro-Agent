# Copy to .env.local (gitignored by Vite) and fill in.
#
# Where the backend listens. The dashboard calls /leads, /campaigns and
# /analytics/stats here.
VITE_API_BASE_URL=http://localhost:8000

# The backend's API_KEY. Anything built into a browser bundle is readable by
# whoever can open the page, so this is for a single operator's local
# dashboard, not for a public deployment. Leave it empty to enter the key in
# the dashboard instead (kept in sessionStorage for the tab).
VITE_API_KEY=
