# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#
# Generate an API key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Application ------------------------------------------------------------
# development | testing | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
BIND_HOST=127.0.0.1
PORT=8000

# Required on every endpoint except /health and /ready. Production refuses to
# start while this is the placeholder.
API_KEY=changeme-in-production

# Comma-separated browser origins. Must be non-empty in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- LLM providers ----------------------------------------------------------
# At least one is needed to generate copy. Without any, the agent falls back to
# its mock responses and says so.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Enrichment -------------------------------------------------------------
# Ordered list of providers. Shipped: manual, public_web.
# Adding a licensed vendor is described in docs/data-sourcing.md.
#
# NOTE: LINKEDIN_EMAIL and LINKEDIN_PASSWORD are deliberately gone. The scraper
# that used them was non-functional and breached LinkedIn's User Agreement.
ENRICHMENT_PROVIDERS=manual

# ---- Data stores ------------------------------------------------------------
# SQLite by default so a fresh clone runs. Use Postgres for anything else;
# production refuses to start on SQLite.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/outreach
REDIS_URL=redis://localhost:6379/0

# ---- Email ------------------------------------------------------------------
# Sending is the one irreversible action here, so it is opt-in.
# Read the compliance note in docs/data-sourcing.md before enabling it:
# this project implements no suppression list, unsubscribe handling or
# consent tracking.
EMAIL_SENDING_ENABLED=false
SENDGRID_API_KEY=
FROM_EMAIL=
FROM_NAME=

# ---- External APIs (optional) -----------------------------------------------
NEWSAPI_KEY=
SERPAPI_KEY=

# ---- Behaviour --------------------------------------------------------------
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_PER_MINUTE=10
MIN_PERSONALIZATION_SCORE=0.7
MAX_RETRIES=3
EMAIL_SEND_DELAY_SECONDS=30
